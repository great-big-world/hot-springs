{
  "type": "lithostitched:set_material_rule",
  "levels": [
    "minecraft:overworld"
  ],
  "target_rules": [
    "minecraft:overworld/biome_surface/default"
  ],
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": [
        "great_big_world:hot_springs",
        "great_big_world:windswept_hot_springs"
      ]
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "max_threshold": 1.7976931348623157E308,
            "min_threshold": 0.46060606060606061,
            "noise": "minecraft:surface"
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "minecraft:coarse_dirt"
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "noise": "great_big_world:hot_springs_surface_tertiary",
            "min_threshold": -64,
            "max_threshold": 0.05
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "great_big_world:golden_travertine"
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "noise": "great_big_world:hot_springs_surface",
            "min_threshold": -64,
            "max_threshold": 0.35
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "great_big_world:ivory_travertine"
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:noise_threshold",
            "noise": "great_big_world:hot_springs_surface_secondary",
            "min_threshold": -64,
            "max_threshold": 0.2
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": "great_big_world:peach_travertine"
          }
        },
        {
          "type": "minecraft:block",
          "result_state": "minecraft:calcite"
        }
      ]
    }
  }
}